# Copia este archivo a .env y completa con los valores de tu proyecto Supabase
# (Project Settings > API). El anon key es público por diseño: la seguridad
# real vive en las políticas RLS y las funciones RPC (ver docs/ARCHITECTURE.md).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
